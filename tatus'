[32m+[m[32m# API路由404错误修复指南[m
[32m+[m
[32m+[m[32m## 问题描述[m
[32m+[m[32m管理员登录时报错：[m
[32m+[m[32m- `Failed to load resource: the server responded with a status of 404 (Not Found)`[m
[32m+[m[32m- `api/admin/login:1 Failed to load resource`[m
[32m+[m[32m- `SyntaxError: Unexpected token '<', "<!DOCTYPE "... is not valid JSON`[m
[32m+[m
[32m+[m[32m## 原因分析[m
[32m+[m[32m前端请求 `/api/admin/login`，但nginx配置中没有将 `/api/` 路径路由到PHP后端，导致返回404 HTML页面。[m
[32m+[m
[32m+[m[32m## 解决方案[m
[32m+[m
[32m+[m[32m### 方法1：修改nginx配置（推荐）[m
[32m+[m
[32m+[m[32m在宝塔面板中：[m
[32m+[m[32m1. 进入"网站" → 找到 `kbitai.com.cn` → 点击"设置"[m
[32m+[m[32m2. 选择"配置文件"标签[m
[32m+[m[32m3. 在 `location /architect` 之前添加以下配置：[m
[32m+[m
[32m+[m[32m```nginx[m
[32m+[m[32m# API路由 - 转发到PHP后端[m
[32m+[m[32mlocation /api/ {[m
[32m+[m[32m    root /www/wwwroot/kbitai.com.cn/architect;[m
[32m+[m[32m    rewrite ^/api/(.*)$ /bankend/index.php last;[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m# PHP处理[m
[32m+[m[32mlocation ~ ^/bankend/.*\.php$ {[m
[32m+[m[32m    root /www/wwwroot/kbitai.com.cn/architect;[m
[32m+[m[32m    fastcgi_pass unix:/tmp/php-cgi-82.sock;[m
[32m+[m[32m    fastcgi_index index.php;[m
[32m+[m[32m    fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;[m
[32m+[m[32m    include fastcgi_params;[m
[32m+[m[32m    fastcgi_connect_timeout 300;[m
[32m+[m[32m    fastcgi_send_timeout 300;[m
[32m+[m[32m    fastcgi_read_timeout 300;[m
[32m+[m[32m}[m
[32m+[m[32m```[m
[32m+[m
